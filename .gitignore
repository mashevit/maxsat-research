# Project data & results
#data/*
!data/toy/
!data/toy/**

# Generated instance corpus (docs/INSTANCEGEN_PLAN.md D6 = option (a)).
# Instances are byte-reproducible from (GenParams, seed) -- see §12 test 1 -- so
# only manifest.jsonl and the tiny test fixture are committed.
# Note: excluding files (not the directory) so the manifest negation below can
# still match -- git does not descend into an excluded directory.
data/generated/**
!data/generated/**/
!data/generated/**/manifest.jsonl
#experiments/
#results/

# OS files
.DS_Store
Thumbs.db
*:Zone.Identifier
solver_EvalMaxSat/
garbage/
cluster_staging/data/
cluster_staging/folder_tree.txt

# Staging tree data: instances out, generated-corpus manifests in (same
# file-not-directory exclusion trick as data/generated above, so the negation
# for manifest.jsonl can match). docs/CORPUS_CALIBRATION_GOALS.md §6 M1.
cluster_staging_maxsat/data/**
!cluster_staging_maxsat/data/**/
!cluster_staging_maxsat/data/generated/**/manifest.jsonl
cluster_staging_maxsat/folder_tree.txt

# MSE-2016 ms_random / ms_crafted benchmark (more_data/): 856 instances, 32 MB,
# downloaded not generated. Same convention as data/generated above -- instances
# out, documentation and manifests in. The sampled subset that experiments
# actually run against is staged into cluster_staging_maxsat/data/mse16/ (also
# ignored) and is recoverable from scripts/sample_mse16_screen.csv, which
# records every pick's sha256.
# Note: excluding files (not the directory) so the negations below can still
# match -- git does not descend into an excluded directory.
more_data/**
!more_data/**/
!more_data/**/*.md
!more_data/**/manifest.jsonl
